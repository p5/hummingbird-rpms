# These are not real spelling errors...
addFilter(r" spelling-error \('((lint|formatt)er|isort|py(docstyle|upgrade)|autoflake)',")
# We *could* add a man page, perhaps. There are a number of subcommands, and it
# would not be easy to keep it up to date.
addFilter(r" no-manual-page-for-binary ruff$")

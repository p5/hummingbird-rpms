framework: shell
require:
- python3
- python3-pytest
- python3-psutil
- python3-psutil-tests
environment:
  # see the comment in %check
  GITHUB_ACTIONS: 1
# test_all also skipped in %check: not reliable?
# test_sensors_temperatures also skipped in %check: https://github.com/giampaolo/psutil/issues/2434
# test_users: https://github.com/giampaolo/psutil/issues/2653
test: |
  python3 -m pytest --pyargs psutil.tests -k "not (test_process_all and test_all) and not (test_system and test_sensors_temperatures and not fahreneit) and not (TestSystemAPIs and test_users)"
tty: true
duration: 15m

[updates-testing]
name=Fedora 43 - $basearch - Test Updates
#baseurl=http://download.example/pub/fedora/linux/updates/testing/43/Everything/$basearch/
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-testing-f43&arch=$basearch
enabled=AUTO_VALUE
countme=1
repo_gpgcheck=0
type=rpm
gpgcheck=1
metadata_expire=6h
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

[updates-testing-debuginfo]
name=Fedora 43 - $basearch - Test Updates Debug
#baseurl=http://download.example/pub/fedora/linux/updates/testing/43/Everything/$basearch/debug/
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-testing-debug-f43&arch=$basearch
enabled=0
repo_gpgcheck=0
type=rpm
gpgcheck=1
metadata_expire=6h
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

[updates-testing-source]
name=Fedora 43 - Test Updates Source
#baseurl=http://download.example/pub/fedora/linux/updates/testing/43/Everything/SRPMS/
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-testing-source-f43&arch=$basearch
enabled=0
repo_gpgcheck=0
type=rpm
gpgcheck=1
metadata_expire=6h
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

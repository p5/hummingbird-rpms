[fedora]
name=Fedora 43 - $basearch
#baseurl=http://download.example/pub/fedora/linux/releases/43/Everything/$basearch/os/
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-43&arch=$basearch
enabled=AUTO_VALUE
countme=1
metadata_expire=AUTO_VALUE
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

[fedora-debuginfo]
name=Fedora 43 - $basearch - Debug
#baseurl=http://download.example/pub/fedora/linux/releases/43/Everything/$basearch/debug/tree/
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-debug-43&arch=$basearch
enabled=0
metadata_expire=AUTO_VALUE
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

[fedora-source]
name=Fedora 43 - Source
#baseurl=http://download.example/pub/fedora/linux/releases/43/Everything/source/tree/
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-source-43&arch=$basearch
enabled=0
metadata_expire=AUTO_VALUE
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-$basearch
skip_if_unavailable=False

+    case PKINIT_DH_P384_BITS: return "P-384";
+    case PKINIT_DH_P521_BITS: return "P-521";
+    case 1024: return "1024-bit DH";
+    case 2048: return "2048-bit DH";
+    case 4096: return "4096-bit DH";
+    }
+    return "(unknown)";
+}

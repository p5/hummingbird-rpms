-#include <openssl/fips.h>
 #else
 #include <openssl/hmac.h>
 #endif
@@ -112,11 +111,7 @@ map_digest(const struct krb5_hash_provider *hash)
         return EVP_sha256();
     else if (hash == &krb5int_hash_sha384)

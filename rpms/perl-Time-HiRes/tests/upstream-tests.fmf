summary: Upstream tests
component: perl-Time-HiRes
require: perl-Time-HiRes-tests
test: /usr/libexec/perl-Time-HiRes/test
enabled: true
tag:
  - rhel-buildroot
  - TestCaseCopy
  - Tier1
tier: '1'
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false

From de478494d2b2b05777b5c030532876d8be9b9d6d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zbigniew=20J=C4=99drzejewski-Szmek?= <zbyszek@in.waw.pl>
Date: Thu, 25 Sep 2025 12:22:25 +0300
Subject: [PATCH 2/3] rpm: use %_prefix not %_usr
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This makes the call work better for builds that don't use the default
prefix, e.g. flatpak builds.

Suggested by Miro Hrončok.
---
 rpm/macros.build-reproducibility | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rpm/macros.build-reproducibility b/rpm/macros.build-reproducibility
index 6b02940..89f2010 100644
--- a/rpm/macros.build-reproducibility
+++ b/rpm/macros.build-reproducibility
@@ -26,8 +26,8 @@
 %linkdupes_options %{nil}
 
 # Directories (or files) to process.
-# By default, all installed files under /usr are processed.
-%linkdupes_paths %{buildroot}%{_usr}
+# By default, all installed files under %%_prefix (/usr) are processed.
+%linkdupes_paths %{buildroot}%{_prefix}
 
 %__os_install_post_hardlink \
     %{?__brp_linkdupes:%{__brp_linkdupes} --brp %{?linkdupes_options} %{?linkdupes_paths}} \

From bdc86de6d4c179f60a2d750d3d1121e2a71dc13c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zbigniew=20J=C4=99drzejewski-Szmek?= <zbyszek@in.waw.pl>
Date: Thu, 25 Sep 2025 12:41:22 +0300
Subject: [PATCH 3/3] linkdupes: allow the argument to not exist when running
 with --brp

See added comment for details.

$ RPM_BUILD_ROOT=/tmp/ target/debug/linkdupes -vv --brp /tmp/missing/
Initialized logging with log level DEBUG
SOURCE_DATE_EPOCH timestamp: (unset)
Failed to process /tmp/missing/: IO error for operation on /tmp/missing/: No such file or directory (os error 2)
Scanned 0 directories and 0 files,
    considered 0 files, read 0 files, linked 0 files, 1 errors
    sum of sizes of linked files: 0 bytes
---
 src/linkdupes/config.rs    |  3 +++
 src/linkdupes/linkfiles.rs | 22 +++++++++++++++++-----
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/src/linkdupes/config.rs b/src/linkdupes/config.rs
index d840eac..960976d 100644
--- a/src/linkdupes/config.rs
+++ b/src/linkdupes/config.rs
@@ -55,6 +55,7 @@ pub struct Config {
     pub root: Option<PathBuf>,  // we need this to do selinux lookups
 
     pub inputs: Vec<PathBuf>,
+    pub brp: bool,
     pub fatal_errors: bool,
     pub _verbose: u8,
     pub dry_run: bool,
@@ -109,6 +110,7 @@ impl Config {
         Ok(Self {
             root,
             inputs: options.inputs,
+            brp: options.brp,
             fatal_errors: options.brp,
             _verbose: options.verbose,
             dry_run: options.dry_run,
@@ -129,6 +131,7 @@ impl Config {
         Self {
             root: None,
             inputs: vec![],
+            brp: false,
             fatal_errors: false,
             _verbose: 0,
             dry_run: false,
diff --git a/src/linkdupes/linkfiles.rs b/src/linkdupes/linkfiles.rs
index dd79c7e..52049b4 100644
--- a/src/linkdupes/linkfiles.rs
+++ b/src/linkdupes/linkfiles.rs
@@ -5,7 +5,7 @@ use log::{trace, debug, info, warn};
 
 use std::cmp::{min, Ordering};
 use std::hash::{DefaultHasher, Hasher};
-use std::io::Read;
+use std::io::{self, Read};
 use std::os::unix::fs::{MetadataExt, PermissionsExt};
 use std::path::{Path, PathBuf};
 use std::cell::RefCell;
@@ -341,12 +341,24 @@ fn process_file_or_dir(
             let entry = match entry {
                 Err(e) => {
                     stats.errors += 1;
-                    if config.fatal_errors {
+
+                    // If fatal errors are enabled, return an error immediately.
+                    // Make an exception for the top-level directory, i.e. the
+                    // command-line argument, when running with --brp. The rpm
+                    // macro calls the program with %_prefix, and if the package
+                    // doesn't install any files there, we'd error out. This
+                    // happened in CI and we don't want this.
+                    if config.fatal_errors &&
+                        !(config.brp &&
+                          e.depth() == 0 &&
+                          e.io_error().is_some_and(
+                             |e| e.kind() == io::ErrorKind::NotFound
+                         )) {
                         return Err(e.into());
-                    } else {
-                        warn!("Failed to process {}: {}", input_path.display(), e);
-                        continue;
                     }
+
+                    warn!("Failed to process {}: {}", input_path.display(), e);
+                    continue;
                 }
                 Ok(entry) => entry
             };

summary: CI Gating Plan
discover:
    how: fmf
    url: https://gitlab.com/redhat/centos-stream/tests/gcc.git
    filter: 'tag: Fedora-CI-gating'
execute:
    how: tmt
adjust:
    - prepare+:
          - name: Add secondary architecture RPMs
            how: shell
            script: ./plans/provide_secondary_arch_rpms.sh
      when: arch == x86_64

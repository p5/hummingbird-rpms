summary: Upstream tests
component: perl-Getopt-Long
require: perl-Getopt-Long-tests
test: /usr/libexec/perl-Getopt-Long/test
enabled: true
tag:
  - rhel-buildroot
  - TestCaseCopy
  - Tier1
tier: '1'
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false

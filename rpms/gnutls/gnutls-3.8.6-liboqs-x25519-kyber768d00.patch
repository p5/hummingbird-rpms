+		GNUTLS_OQS_FUNC(OQS_KEM_free)(kem);
+		ret = 0;
+	} break;
+#endif
+	default:
+		ret = gnutls_assert_val(GNUTLS_E_UNKNOWN_ALGORITHM);
+		goto cleanup;
+	}

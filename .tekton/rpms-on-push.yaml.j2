{%- for rpm in rpms -%}
# --- {{ rpm.dname }} ---
{%- if rpm.imported %}
{{ pipeline_run(
    rpm=rpm,
    event_type='push',
    cancel_in_progress='false',
    output_image_tag='{{revision}}',
    extra_path_changes=rpm.extra_path_changes if rpm.extra_path_changes is defined else [],
    timeout_hours=rpm.timeout_hours,
    build_platforms=rpm.build_platforms if rpm.build_platforms is defined else None,
    task_run_specs=rpm.task_run_specs if rpm.task_run_specs is defined else None,
) -}}
{%- else %}
# PENDING
{%- endif %}
{% endfor -%}
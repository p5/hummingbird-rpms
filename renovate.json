{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update PIPELINE_BUNDLE digest in generate_pac_resources.sh",
      "managerFilePatterns": ["/ci/generate_pac_resources\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*PIPELINE_BUNDLE=\"[^:]+:(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update pipeline bundle references in rendered Tekton YAML files",
      "managerFilePatterns": ["/\\.tekton/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*value:\\s*\"[^:]+:(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all rpmbuild-pipeline updates together",
      "matchPackageNames": ["/rpmbuild-pipeline/"],
      "groupName": "rpmbuild-pipeline"
    }
  ]
}
